{
  "manifest_version": 3,
  "name": "UpnLibX — Pengunduh PDF OPAC UPN",
  "short_name": "UpnLibX",
  "version": "1.0.0",
  "description": "Ekstrak dan unduh skripsi/tugas akhir dari OPAC Digital Library UPN 'Veteran' Yogyakarta (192.168.36.203) menjadi satu file PDF A4 utuh bebas duplikat.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UpnLibX — Ekstrak PDF OPAC UPN",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://192.168.36.203/*",
    "https://192.168.36.203/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://192.168.36.203/*",
        "https://192.168.36.203/*"
      ],
      "js": [
        "vendor/pdf-lib.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "upnlibx-extractor@upnyk.local",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  }
}
